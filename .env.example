# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Set to true when running behind HTTPS (reverse proxy). Leave false for local dev.
COOKIE_SECURE=false

# The public URL of this app (used to build the Plex OAuth callback URL)
# For local dev: http://localhost:3000
# For production: https://your-domain.com
APP_URL=https://your-domain.com

# ── Plex ──────────────────────────────────────────────────
# Your Plex server URL as seen FROM the Docker container.
# Use the local/LAN address — not your external domain — so transcoding
# requests stay on your LAN and don't round-trip through your reverse proxy.
# Examples:
#   http://host.docker.internal:32400   (Docker on Windows/Mac)
#   http://192.168.1.100:32400          (LAN IP if host.docker.internal doesn't work)
PLEX_URL=http://host.docker.internal:32400

# Your Plex server token (Settings → Troubleshooting → "Your Plex Token" link)
PLEX_TOKEN=your-plex-token-here

# Unique identifier for this app (any stable string is fine)
# Required: unique identifier for this app in Plex OAuth flows (e.g. your-app-name-prod)
PLEX_CLIENT_ID=your-unique-app-id

# Default timezone for scheduled rooms (IANA timezone string, e.g. America/New_York).
# Used when the client doesn't send a valid timezone.
DEFAULT_TIMEZONE=America/New_York

# ── Chat & moderation (all optional; all but the Giphy key can also be changed on the admin Settings page) ──
# GIFs in chat: create an app at https://developers.giphy.com and pick "API" (not SDK).
# GIPHY_API_KEY=
# Most mature GIFs allowed: g | pg | pg-13 | r
# GIPHY_RATING=pg-13
# Who may post images in chat: all | plex | off
# CHAT_UPLOADS=all
# Offensive-word filter for chat and names, plus comma-separated words to add or to always allow
# WORD_FILTER=true
# WORD_FILTER_EXTRA=
# WORD_FILTER_ALLOW=

# ── Room Types ─────────────────────────────────────────────
# Set to false to hide a room type from the lobby.
ROOM_TYPE_MOVIE=true
ROOM_TYPE_TV=true
ROOM_TYPE_YOUTUBE=true
ROOM_TYPE_LIVETV=false

# ── Live TV (requires ROOM_TYPE_LIVETV=true) ───────────────
# Video comes straight from an HDHomeRun tuner via ffmpeg (bundled in the Docker image);
# Plex is only used for the channel guide / now-playing data.
# HDHomeRun tuner address. If HDHR_IP is unset (or LIVETV_SOURCE=plex), video is tuned through
# Plex's DVR instead.
HDHR_IP=192.168.1.115
HDHR_PORT=5004
# LIVETV_SOURCE=hdhr            # or 'plex'
# Seconds of playback buffer (distance behind the newest recorded video). Higher = fewer stutters,
# more delay from the broadcast, longer start-up. Default 10.
# LIVETV_BUFFER_SEC=10
# Upscale low-resolution channels (e.g. 480i) to this height with Lanczos + a light sharpen; HD channels are untouched.
# LIVETV_UPSCALE=720      # 720 or 1080; unset = off. LIVETV_SHARPEN=0.5 sets sharpen strength (0 = off).
# Software H.264 encode (CPU). Tune with: LIVETV_X264_PRESET=veryfast  LIVETV_MAX_BITRATE=8M
# Intel or AMD iGPU (Linux host): LIVETV_HWACCEL=vaapi and run with docker-compose.vaapi.yml (passes in /dev/dri).
# Falls back to software automatically if the GPU isn't available.
# LIVETV_HWACCEL=vaapi
# LIVETV_VAAPI_DEVICE=/dev/dri/renderD128   # optional; default = first Intel/AMD render node
# Other hardware encoders: LIVETV_VIDEO_ARGS=-c:v h264_nvenc -preset p4 -b:v 6M
# Seconds that must pass between pauses in a Live TV room (default 10; 0 = off). Stops play/pause spam from
# disrupting the stream. Movie and TV rooms are not limited.
# LIVETV_PAUSE_COOLDOWN_SEC=10
# Most Live TV rooms that may stream at once (default 2). Each one holds a tuner and an encoder, so keep this at or
# below your tuner count and what your CPU/GPU can encode. Rooms that are open but idle don't count.
# LIVETV_MAX_ROOMS=2
# Plex server used for EPG guide data (can differ from PLEX_URL)
LIVETV_PLEX_HOST=http://192.168.1.225:32400
# Token for the Live TV Plex server. If unset, falls back to PLEX_TOKEN.
# LIVETV_PLEX_TOKEN=

